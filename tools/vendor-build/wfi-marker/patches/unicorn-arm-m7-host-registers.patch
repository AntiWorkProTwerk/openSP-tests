+/* Called only by callbacks installed on a live engine, never by contexts. */
+static bool m7_live_register_access(CPUARMState *env)
+{
+    return env->uc->cpu_model == UC_CPU_ARM_CORTEX_M7 &&
+           arm_feature(env, ARM_FEATURE_M) &&
+           !arm_feature(env, ARM_FEATURE_M_SECURITY);
+}
+
+void arm_m7_host_write_control(CPUARMState *env, uint32_t val);
+
+static uint32_t v7m_host_reg_read(CPUARMState *env, uint32_t reg, bool raw_m7)
+{
+    if (!raw_m7) {
+        return helper_v7m_mrs(env, reg);
+    }
+    switch (reg) {
+    case 8: /* MSP */
+        return v7m_using_psp(env) ? env->v7m.other_sp : env->regs[13];
+    case 9: /* PSP */
+        return v7m_using_psp(env) ? env->regs[13] : env->v7m.other_sp;
+    case 16: /* PRIMASK */
+        return env->v7m.primask[env->v7m.secure];
+    case 17: /* BASEPRI */
+    case 18: /* BASEPRI_MAX read alias */
+        return env->v7m.basepri[env->v7m.secure];
+    case 19: /* FAULTMASK */
+        return env->v7m.faultmask[env->v7m.secure];
+    case 20: /* CONTROL; FPCA is stored in the S bank even on M7. */
+        return env->v7m.control[env->v7m.secure] |
+               (env->v7m.control[M_REG_S] & R_V7M_CONTROL_FPCA_MASK);
+    default:
+        return helper_v7m_mrs(env, reg);
+    }
+}
+
+static void v7m_host_reg_write(CPUARMState *env, uint32_t reg, uint32_t val,
+                               bool raw_m7)
+{
+    if (!raw_m7) {
+        helper_v7m_msr(env, reg, val);
+        return;
+    }
+    switch (reg) {
+    case 8: /* MSP */
+        if (v7m_using_psp(env)) {
+            env->v7m.other_sp = val;
+        } else {
+            env->regs[13] = val;
+        }
+        break;
+    case 9: /* PSP */
+        if (v7m_using_psp(env)) {
+            env->regs[13] = val;
+        } else {
+            env->v7m.other_sp = val;
+        }
+        break;
+    case 16: /* PRIMASK */
+        env->v7m.primask[env->v7m.secure] = val & 1;
+        break;
+    case 17: /* BASEPRI */
+        env->v7m.basepri[env->v7m.secure] = val & 0xff;
+        break;
+    case 18: /* Preserve BASEPRI_MAX's priority-raising semantics. */
+        val &= 0xff;
+        if (val && (!env->v7m.basepri[env->v7m.secure] ||
+                    val < env->v7m.basepri[env->v7m.secure])) {
+            env->v7m.basepri[env->v7m.secure] = val;
+        }
+        break;
+    case 19: /* FAULTMASK */
+        env->v7m.faultmask[env->v7m.secure] = val & 1;
+        break;
+    case 20: /* Host restoration bypasses guest CONTROL write restrictions. */
+        arm_m7_host_write_control(env, val);
+        return;
+    default:
+        helper_v7m_msr(env, reg, val);
+        return;
+    }
+    arm_rebuild_hflags(env);
+}
