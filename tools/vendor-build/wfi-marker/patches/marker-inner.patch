+/* Private scalar observation; valid live M7 handles, outside native execution. */
+UNICORN_EXPORT
+uint32_t uc_arm_wfi_event_field(uc_engine *uc, uint32_t field)
+{
+#ifdef UNICORN_HAS_ARM
+    if (uc && uc->arch == UC_ARCH_ARM &&
+        uc->cpu_model == UC_CPU_ARM_CORTEX_M7 && uc->nested_level == 0 &&
+        !uc->arm_wfi_nested_seen &&
+        field < 4) {
+        return uc->arm_wfi_event[field];
+    }
+#endif
+    return 0;
+}
