{
  "name": "opensp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "dev": "node tools/build-design-tokens.mjs && astro dev --host 127.0.0.1",
    "build": "node tools/build-design-tokens.mjs && astro build && node tools/check-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node tools/check-journey.mjs --exercises && node tools/check-demos.mjs && npm run test:source-publication && npm run test:opensynth-patcher && npm run test:features && npm run test:emulator && playwright test",
    "test:source-publication": "node --test --test-isolation=none tests/source-patcher-publication.test.mjs",
    "test:opensynth-patcher": "node --import ./tools/register-test-typescript.mjs --test tests/opensynth-patcher.test.mjs tests/opensynth-r50-webhid.test.mjs",
    "test:features": "node --import ./tools/register-test-typescript.mjs --test tests/features-*.test.mjs",
    "test:emulator": "node --import ./tools/register-test-typescript.mjs --test tests/emulator-*.test.mjs && node --import ./tools/register-test-typescript.mjs tools/test-emulator-cpu.mjs",
    "test:emulator:firmware": "node tools/test-emulator-firmware.mjs && node tools/test-emulator-stock.mjs",
    "test:journey": "node tools/check-journey.mjs --exercises",
    "test:demos": "node tools/check-demos.mjs",
    "test:install": "playwright install chromium",
    "design:pull": "node tools/pull-penpot.mjs",
    "design:pull-guide": "node tools/pull-guide-design.mjs",
    "design:pull-journey": "node tools/pull-journey-design.mjs",
    "design:tokens": "node tools/build-design-tokens.mjs"
  },
  "dependencies": {
    "astro": "7.3.5",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/sitemap": "3.7.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.13.0",
    "typescript": "6.0.3"
  }
}
